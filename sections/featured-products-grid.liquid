<section class="featured-products">
  <div class="featured-products__container">
    <div class="featured-products__header">
      {% if section.settings.eyebrow != blank %}
        <span class="featured-products__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}

      {% if section.settings.title != blank %}
        <h2 class="featured-products__title">{{ section.settings.title }}</h2>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <p class="featured-products__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="featured-products__grid">
      {% for block in section.blocks %}
        {% liquid
          assign product = block.settings.product
          assign item_title = block.settings.title
          assign item_text = block.settings.description
          assign item_price = block.settings.price_text
          assign item_link = block.settings.link
          assign item_image_url = block.settings.image_url
          assign item_alt = block.settings.image_alt

          if product != blank
            assign item_title = product.title
            assign item_link = product.url
            assign item_image_url = product.featured_image | image_url: width: 1200
            assign item_alt = product.featured_image.alt | default: product.title
            assign item_price = product.price | money
            if item_text == blank
              assign item_text = product.description | strip_html | truncate: 150
            endif
          elsif block.settings.image != blank
            assign item_image_url = block.settings.image | image_url: width: 1200
          endif
        %}

        <article class="featured-product-card" {{ block.shopify_attributes }}>
          {% if item_image_url != blank %}
            <a href="{{ item_link | default: '#' }}" class="featured-product-card__image-wrap">
              <img src="{{ item_image_url }}" alt="{{ item_alt | escape }}" loading="lazy">
            </a>
          {% endif %}

          <div class="featured-product-card__content">
            {% if item_title != blank %}
              <h3 class="featured-product-card__title">{{ item_title }}</h3>
            {% endif %}

            {% if item_text != blank %}
              <p class="featured-product-card__desc">{{ item_text }}</p>
            {% endif %}

            <div class="featured-product-card__footer">
              {% if item_price != blank %}
                <span class="featured-product-card__price">{{ item_price }}</span>
              {% endif %}

              {% if block.settings.button_label != blank %}
                <a href="{{ item_link | default: '#' }}" class="featured-product-card__btn">
                  {{ block.settings.button_label }}
                </a>
              {% endif %}
            </div>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .featured-products {
    position: relative;
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    background:
      radial-gradient(circle at top left, {{ section.settings.accent_color | color_modify: 'alpha', 0.18 }}, transparent 28%),
      radial-gradient(circle at bottom right, {{ section.settings.background_end | color_modify: 'alpha', 0.95 }}, transparent 30%),
      linear-gradient(180deg, {{ section.settings.background_start }} 0%, {{ section.settings.background_end }} 100%);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .featured-products::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(255, 255, 255, 0.14) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.14) 1px, transparent 1px);
    background-size: 34px 34px;
    opacity: 0.35;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .featured-products__container {
    position: relative;
    z-index: 1;
    max-width: 1320px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .featured-products__header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 42px;
  }

  #shopify-section-{{ section.id }} .featured-products__eyebrow {
    display: inline-block;
    margin-bottom: 14px;
    padding: 9px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid {{ section.settings.accent_color | color_modify: 'alpha', 0.12 }};
    color: {{ section.settings.accent_color }};
    font-family: Arial, Helvetica, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .featured-products__title {
    margin: 0 0 12px;
    color: {{ section.settings.heading_color }};
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    font-weight: 600;
    font-family: Georgia, "Times New Roman", serif;
  }

  #shopify-section-{{ section.id }} .featured-products__subtitle {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: 16px;
    line-height: 1.7;
    font-family: Arial, Helvetica, sans-serif;
  }

  #shopify-section-{{ section.id }} .featured-products__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 26px;
  }

  #shopify-section-{{ section.id }} .featured-product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid {{ section.settings.accent_color | color_modify: 'alpha', 0.08 }};
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 14px 40px {{ section.settings.accent_color | color_modify: 'alpha', 0.07 }};
    backdrop-filter: blur(10px);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  #shopify-section-{{ section.id }} .featured-product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 50px {{ section.settings.accent_color | color_modify: 'alpha', 0.12 }};
  }

  #shopify-section-{{ section.id }} .featured-product-card__image-wrap {
    display: block;
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: linear-gradient(180deg, #fff7fa 0%, #fdeff4 100%);
  }

  #shopify-section-{{ section.id }} .featured-product-card__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }

  #shopify-section-{{ section.id }} .featured-product-card:hover .featured-product-card__image-wrap img {
    transform: scale(1.05);
  }

  #shopify-section-{{ section.id }} .featured-product-card__content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 22px 22px 20px;
  }

  #shopify-section-{{ section.id }} .featured-product-card__title {
    margin: 0 0 10px;
    color: {{ section.settings.heading_color }};
    font-size: 22px;
    line-height: 1.2;
    font-weight: 600;
    font-family: Georgia, "Times New Roman", serif;
  }

  #shopify-section-{{ section.id }} .featured-product-card__desc {
    margin: 0 0 22px;
    color: {{ section.settings.text_color }};
    font-size: 14px;
    line-height: 1.75;
    font-family: Arial, Helvetica, sans-serif;
  }

  #shopify-section-{{ section.id }} .featured-product-card__footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .featured-product-card__price {
    color: {{ section.settings.accent_color }};
    font-size: 20px;
    font-weight: 700;
    font-family: Arial, Helvetica, sans-serif;
  }

  #shopify-section-{{ section.id }} .featured-product-card__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 18px;
    border-radius: 999px;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    font-family: Arial, Helvetica, sans-serif;
    letter-spacing: 0.02em;
    transition: transform 0.25s ease, opacity 0.25s ease, box-shadow 0.25s ease;
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.14);
  }

  #shopify-section-{{ section.id }} .featured-product-card__btn:hover {
    transform: translateY(-2px);
    opacity: 0.95;
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.18);
  }

  @media (max-width: 991px) {
    #shopify-section-{{ section.id }} .featured-products {
      padding-left: 18px;
      padding-right: 18px;
    }

    #shopify-section-{{ section.id }} .featured-products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
  }

  @media (max-width: 640px) {
    #shopify-section-{{ section.id }} .featured-products {
      padding-left: 16px;
      padding-right: 16px;
    }

    #shopify-section-{{ section.id }} .featured-products__header {
      margin-bottom: 30px;
    }

    #shopify-section-{{ section.id }} .featured-products__grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    #shopify-section-{{ section.id }} .featured-product-card {
      border-radius: 20px;
    }

    #shopify-section-{{ section.id }} .featured-product-card__content {
      padding: 18px;
    }

    #shopify-section-{{ section.id }} .featured-product-card__title {
      font-size: 20px;
    }

    #shopify-section-{{ section.id }} .featured-product-card__footer {
      align-items: stretch;
      flex-direction: column;
    }

    #shopify-section-{{ section.id }} .featured-product-card__btn {
      width: 100%;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Featured Products Grid",
  "tag": "section",
  "class": "section-featured-products-grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Featured Products"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Glow-worthy essentials, handpicked for you"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Discover our most-loved beauty picks curated for effortless everyday glam, radiant skin, and confidence in every swipe."
    },
    {
      "type": "color",
      "id": "background_start",
      "label": "Background start",
      "default": "#fff9fb"
    },
    {
      "type": "color",
      "id": "background_end",
      "label": "Background end",
      "default": "#fff3f7"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#a70055"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1115"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#6f5d65"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "default": 90,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "default": 90,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Fallback image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Fallback image URL",
          "default": "https://images.rawpixel.com/image_800/cHJpdmF0ZS9sci9pbWFnZXMvd2Vic2l0ZS8yMDIyLTExL3JtMzYyLTAxYS1tb2NrdXAuanBn.jpg"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Fallback title",
          "default": "Founder Glow Lipstick"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "A richly pigmented lipstick that delivers smooth application and a radiant finish for everyday wear."
        },
        {
          "type": "text",
          "id": "price_text",
          "label": "Fallback price",
          "default": "$24.00"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Fallback link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "View Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Products Grid",
      "blocks": [
        {
          "type": "product_card"
        },
        {
          "type": "product_card",
          "settings": {
            "title": "Velvet Touch Blush",
            "description": "Lightweight and buildable blush designed to add a soft, natural-looking flush to your complexion.",
            "price_text": "$19.00"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "title": "Luminous Skin Serum",
            "description": "A skin-first formula crafted to hydrate, brighten, and prep your skin for a flawless makeup base.",
            "price_text": "$32.00"
          }
        }
      ]
    }
  ]
}
{% endschema %}
