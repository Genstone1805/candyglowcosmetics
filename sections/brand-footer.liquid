<footer class="cg-footer">
  <div class="cg-footer-container">
    <div class="cg-footer-grid">
      <div class="cg-footer-brand">
        {% if section.settings.brand_heading != blank %}
          <h3>{{ section.settings.brand_heading }}</h3>
        {% endif %}

        {% if section.settings.brand_text != blank %}
          <p>{{ section.settings.brand_text }}</p>
        {% endif %}
      </div>

      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'menu_column' %}
            <div class="cg-footer-links" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h4>{{ block.settings.heading }}</h4>
              {% endif %}

              {% assign footer_menu = linklists[block.settings.menu] %}
              {% if footer_menu.links != blank %}
                <ul>
                  {% for link in footer_menu.links %}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
        {% endcase %}
      {% endfor %}

      <div class="cg-footer-features">
        {% if section.settings.features_heading != blank %}
          <h4>{{ section.settings.features_heading }}</h4>
        {% endif %}

        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'feature' %}
              <div class="feature" {{ block.shopify_attributes }}>
                {% if block.settings.heading != blank %}
                  <h5>{{ block.settings.heading }}</h5>
                {% endif %}

                {% if block.settings.text != blank %}
                  <p>{{ block.settings.text }}</p>
                {% endif %}
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    </div>

    <div class="cg-footer-bottom">
      {% if section.settings.copyright_text != blank %}
        <p class="cg-footer-thanks">{{ section.settings.copyright_text }}</p>
      {% endif %}

      <div class="cg-footer-socials">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'social_link' %}
              {% if block.settings.label != blank %}
                <a href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
                  {{ block.settings.label }}
                </a>
              {% endif %}
          {% endcase %}
        {% endfor %}
      </div>

      <div class="cg-footer-payments">
        {% if section.settings.payments_label != blank %}
          <span>{{ section.settings.payments_label }}</span>
        {% endif %}

        <div class="payment-icons">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'payment_method' %}
                {% if block.settings.label != blank %}
                  <span {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
                {% endif %}
            {% endcase %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</footer>

{% style %}
  #shopify-section-{{ section.id }} .cg-footer {
    background: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    font-family: Arial, Helvetica, sans-serif;
    color: {{ section.settings.text_color }};
    border-top: 1px solid {{ section.settings.border_color }};
  }

  #shopify-section-{{ section.id }} .cg-footer-container {
    max-width: 1300px;
    margin: auto;
  }

  #shopify-section-{{ section.id }} .cg-footer-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr 0.8fr 1.2fr;
    gap: 40px;
    margin-bottom: 40px;
  }

  #shopify-section-{{ section.id }} .cg-footer-brand h3 {
    font-family: Georgia, serif;
    font-size: 30px;
    margin-bottom: 16px;
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .cg-footer-brand p {
    font-size: 14px;
    line-height: 1.8;
    color: {{ section.settings.muted_text_color }};
    max-width: 380px;
  }

  #shopify-section-{{ section.id }} .cg-footer-links h4,
  #shopify-section-{{ section.id }} .cg-footer-features h4 {
    font-size: 18px;
    margin-bottom: 16px;
    font-family: Georgia, serif;
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .cg-footer-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .cg-footer-links li {
    margin-bottom: 10px;
  }

  #shopify-section-{{ section.id }} .cg-footer-links a,
  #shopify-section-{{ section.id }} .cg-footer-socials a {
    text-decoration: none;
    color: {{ section.settings.link_color }};
    font-size: 14px;
    transition: 0.25s;
  }

  #shopify-section-{{ section.id }} .cg-footer-links a:hover,
  #shopify-section-{{ section.id }} .cg-footer-socials a:hover {
    color: {{ section.settings.link_hover_color }};
  }

  #shopify-section-{{ section.id }} .feature {
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .feature h5 {
    font-size: 14px;
    margin-bottom: 6px;
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .feature p {
    font-size: 13px;
    color: {{ section.settings.muted_text_color }};
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .cg-footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    padding-top: 25px;
    border-top: 1px solid {{ section.settings.border_color }};
  }

  #shopify-section-{{ section.id }} .cg-footer-thanks {
    font-size: 13px;
    color: {{ section.settings.muted_text_color }};
    max-width: 420px;
  }

  #shopify-section-{{ section.id }} .cg-footer-socials {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .cg-footer-payments {
    text-align: right;
    font-size: 13px;
    color: {{ section.settings.muted_text_color }};
  }

  #shopify-section-{{ section.id }} .payment-icons {
    display: flex;
    gap: 10px;
    margin-top: 6px;
    justify-content: flex-end;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .payment-icons span {
    background: {{ section.settings.payment_background }};
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 12px;
    color: {{ section.settings.text_color }};
  }

  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .cg-footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    #shopify-section-{{ section.id }} .cg-footer-bottom {
      flex-direction: column;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .payment-icons {
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .cg-footer-payments {
      text-align: center;
    }
  }

  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} .cg-footer-grid {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

