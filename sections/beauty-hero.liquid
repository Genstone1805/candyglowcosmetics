{% liquid
  assign background_image_url = section.settings.background_image_url
  if section.settings.background_image != blank
    assign background_image_url = section.settings.background_image | image_url: width: 2400
  endif

  assign main_image_url = section.settings.main_image_url
  if section.settings.main_image != blank
    assign main_image_url = section.settings.main_image | image_url: width: 1600
  elsif main_image_url == blank
    assign main_image_url = 'img1.png' | asset_url
  endif

  assign hero_slide_count = section.blocks.size
  if hero_slide_count == 0
    assign hero_slide_count = 1
  endif

  assign hero_slider_id = 'beauty-hero-slider-' | append: section.id
%}

<section
  class="beauty-hero"
  id="{{ hero_slider_id }}"
  data-autoplay-ms="{{ section.settings.autoplay_seconds | times: 1000 }}"
  aria-label="Home banner slider"
>
  <div class="beauty-hero__viewport">
    <div class="beauty-hero__overlay beauty-hero__overlay--top"></div>
    <div class="beauty-hero__overlay beauty-hero__overlay--bottom"></div>

    <div class="beauty-hero__track">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% liquid
            assign slide_background_image_url = block.settings.background_image_url
            if block.settings.background_image != blank
              assign slide_background_image_url = block.settings.background_image | image_url: width: 2400
            elsif slide_background_image_url == blank
              assign slide_background_image_url = background_image_url
            endif

            assign slide_main_image_url = block.settings.main_image_url
            if block.settings.main_image != blank
              assign slide_main_image_url = block.settings.main_image | image_url: width: 1600
            elsif slide_main_image_url == blank
              assign slide_main_image_url = main_image_url
            endif

            assign slide_brand_name = block.settings.brand_name | default: section.settings.brand_name
            assign slide_title = block.settings.title | default: section.settings.title
            assign slide_description = block.settings.description | default: section.settings.description
            assign slide_offer_text = block.settings.offer_text | default: section.settings.offer_text
            assign slide_button_label = block.settings.button_label | default: section.settings.button_label
            assign slide_button_link = block.settings.button_link | default: section.settings.button_link | default: '#'
            assign slide_main_image_alt = block.settings.main_image_alt | default: section.settings.main_image_alt | default: slide_title
          %}

          <article
            class="beauty-hero__slide"
            {% if slide_background_image_url != blank %}
              style="--hero-bg:url('{{ slide_background_image_url }}');"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <div class="beauty-hero__inner">
              <div class="beauty-hero__content">
                {% if slide_brand_name != blank %}
                  <div class="beauty-hero__brand">{{ slide_brand_name }}</div>
                {% endif %}

                {% if slide_title != blank %}
                  <h1 class="beauty-hero__title">{{ slide_title | newline_to_br }}</h1>
                {% endif %}

                {% if slide_description != blank %}
                  <p class="beauty-hero__desc">{{ slide_description }}</p>
                {% endif %}

                {% if slide_offer_text != blank %}
                  <div class="beauty-hero__offer">{{ slide_offer_text }}</div>
                {% endif %}

                {% if slide_button_label != blank %}
                  <a href="{{ slide_button_link }}" class="beauty-hero__btn">
                    {{ slide_button_label }}
                  </a>
                {% endif %}
              </div>

              <div class="beauty-hero__visual">
                {% if slide_main_image_url != blank %}
                  <img
                    class="beauty-hero__main-image"
                    src="{{ slide_main_image_url }}"
                    alt="{{ slide_main_image_alt | escape }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    {% if forloop.first %}
                      fetchpriority="high"
                    {% endif %}
                  >
                {% endif %}
              </div>
            </div>
          </article>
        {% endfor %}
      {% else %}
        <article
          class="beauty-hero__slide"
          {% if background_image_url != blank %}
            style="--hero-bg:url('{{ background_image_url }}');"
          {% endif %}
        >
          <div class="beauty-hero__inner">
            <div class="beauty-hero__content">
              {% if section.settings.brand_name != blank %}
                <div class="beauty-hero__brand">{{ section.settings.brand_name }}</div>
              {% endif %}

              {% if section.settings.title != blank %}
                <h1 class="beauty-hero__title">{{ section.settings.title | newline_to_br }}</h1>
              {% endif %}

              {% if section.settings.description != blank %}
                <p class="beauty-hero__desc">{{ section.settings.description }}</p>
              {% endif %}

              {% if section.settings.offer_text != blank %}
                <div class="beauty-hero__offer">{{ section.settings.offer_text }}</div>
              {% endif %}

              {% if section.settings.button_label != blank %}
                <a href="{{ section.settings.button_link | default: '#' }}" class="beauty-hero__btn">
                  {{ section.settings.button_label }}
                </a>
              {% endif %}
            </div>

            <div class="beauty-hero__visual">
              {% if main_image_url != blank %}
                <img
                  class="beauty-hero__main-image"
                  src="{{ main_image_url }}"
                  alt="{{ section.settings.main_image_alt | default: section.settings.title | escape }}"
                  loading="eager"
                  fetchpriority="high"
                >
              {% endif %}
            </div>
          </div>
        </article>
      {% endif %}
    </div>
  </div>

  {% if hero_slide_count > 1 %}
    <div class="beauty-hero__indicators" aria-label="Banner indicators"></div>
  {% endif %}
</section>

{% style %}
  #shopify-section-{{ section.id }} .beauty-hero {
    position: relative;
    overflow: hidden;
    width: 100%;
    background: {{ section.settings.background_color }};
    font-family: Georgia, "Times New Roman", serif;
    padding-bottom: {% if hero_slide_count > 1 %}22px{% else %}0{% endif %};
  }

  #shopify-section-{{ section.id }} .beauty-hero__viewport {
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .beauty-hero__track {
    display: flex;
    transition: transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  #shopify-section-{{ section.id }} .beauty-hero__slide {
    position: relative;
    flex: 0 0 100%;
    min-height: {{ section.settings.min_height }}px;
    background-color: {{ section.settings.background_color }};
    background-image: var(--hero-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  #shopify-section-{{ section.id }} .beauty-hero__slide::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      {{ section.settings.overlay_color | color_modify: 'alpha', 0.82 }} 0%,
      {{ section.settings.overlay_color | color_modify: 'alpha', 0.72 }} 34%,
      {{ section.settings.overlay_color | color_modify: 'alpha', 0.26 }} 66%,
      {{ section.settings.overlay_color | color_modify: 'alpha', 0.1 }} 100%
    );
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .beauty-hero__overlay {
    position: absolute;
    left: 0;
    width: 100%;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .beauty-hero__overlay--top {
    top: 0;
    height: 42%;
    z-index: 1;
    background:
      radial-gradient(circle at 10% 25%, rgba(255, 255, 255, 0.6) 0 38px, transparent 39px),
      radial-gradient(circle at 23% 20%, rgba(255, 255, 255, 0.4) 0 27px, transparent 28px),
      radial-gradient(circle at 40% 18%, rgba(255, 255, 255, 0.3) 0 34px, transparent 35px),
      radial-gradient(circle at 63% 16%, rgba(255, 255, 255, 0.35) 0 42px, transparent 43px),
      radial-gradient(circle at 79% 20%, rgba(255, 255, 255, 0.4) 0 30px, transparent 31px),
      radial-gradient(circle at 91% 16%, rgba(255, 255, 255, 0.25) 0 22px, transparent 23px),
      radial-gradient(circle at 14% 6%, rgba(255, 255, 255, 0.55) 0 7px, transparent 8px),
      radial-gradient(circle at 36% 7%, rgba(255, 255, 255, 0.48) 0 5px, transparent 6px),
      radial-gradient(circle at 58% 10%, rgba(255, 255, 255, 0.5) 0 6px, transparent 7px),
      radial-gradient(circle at 86% 8%, rgba(255, 255, 255, 0.45) 0 6px, transparent 7px);
  }

  #shopify-section-{{ section.id }} .beauty-hero__overlay--bottom {
    bottom: 0;
    height: 26%;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.829)),
      radial-gradient(circle at 10% 60%, rgba(255, 255, 255, 0.35) 0 34px, transparent 35px),
      radial-gradient(circle at 26% 55%, rgba(255, 255, 255, 0.22) 0 28px, transparent 29px),
      radial-gradient(circle at 47% 68%, rgba(255, 255, 255, 0.2) 0 32px, transparent 33px),
      radial-gradient(circle at 70% 58%, rgba(255, 255, 255, 0.2) 0 26px, transparent 27px),
      radial-gradient(circle at 88% 62%, rgba(255, 255, 255, 0.25) 0 34px, transparent 35px);
  }

  #shopify-section-{{ section.id }} .beauty-hero__inner {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: 10px;
    min-height: {{ section.settings.min_height }}px;
    max-width: 1380px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 50px {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .beauty-hero__content {
    max-width: 420px;
    padding-left: 18px;
    padding-bottom: 130px;
  }

  #shopify-section-{{ section.id }} .beauty-hero__brand {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 18px;
    color: {{ section.settings.brand_color }};
    margin-bottom: 6px;
    letter-spacing: 0.2px;
  }

  #shopify-section-{{ section.id }} .beauty-hero__title {
    margin: 0;
    color: {{ section.settings.title_color }};
    font-size: 64px;
    line-height: 0.95;
    font-weight: 500;
    letter-spacing: 0;
  }

  #shopify-section-{{ section.id }} .beauty-hero__desc {
    margin: 12px 0 14px;
    max-width: 430px;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 18px;
    line-height: 1.35;
    color: {{ section.settings.description_color }};
  }

  #shopify-section-{{ section.id }} .beauty-hero__offer {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 20px;
    font-weight: 400;
    color: {{ section.settings.offer_color }};
    margin-bottom: 18px;
  }

  #shopify-section-{{ section.id }} .beauty-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 160px;
    min-height: 44px;
    padding: 0 20px;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;
    border-radius: 999px;
    letter-spacing: 0.08em;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.16);
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  #shopify-section-{{ section.id }} .beauty-hero__btn:hover {
    transform: translateY(-1px);
    opacity: 0.92;
  }

  #shopify-section-{{ section.id }} .beauty-hero__visual {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: {{ section.settings.min_height }}px;
  }

  #shopify-section-{{ section.id }} .beauty-hero__main-image {
    display: block;
    width: min(100%, 760px);
    max-width: 760px;
    max-height: calc({{ section.settings.min_height }}px - 40px);
    object-fit: contain;
    object-position: bottom center;
    margin-bottom: 0;
    filter: drop-shadow(0 18px 20px rgba(0, 0, 0, 0.12));
  }

  #shopify-section-{{ section.id }} .beauty-hero__indicators {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 18px;
  }

  #shopify-section-{{ section.id }} .beauty-hero__indicator {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    border: none;
    background: rgba(17, 17, 17, 0.22);
    cursor: pointer;
    padding: 0;
    transition: background 0.25s ease, width 0.25s ease, transform 0.25s ease;
  }

  #shopify-section-{{ section.id }} .beauty-hero__indicator.is-active {
    width: 34px;
    background: #111111;
  }

  @media (max-width: 991px) {
    #shopify-section-{{ section.id }} .beauty-hero__inner {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: {{ section.settings.padding_top }}px 24px 28px;
      text-align: center;
      align-items: center;
    }

    #shopify-section-{{ section.id }} .beauty-hero__content {
      max-width: 100%;
      padding-left: 0;
      padding-bottom: 0;
      margin: 0 auto;
    }

    #shopify-section-{{ section.id }} .beauty-hero__desc {
      margin-left: auto;
      margin-right: auto;
      max-width: 520px;
    }

    #shopify-section-{{ section.id }} .beauty-hero__visual {
      min-height: auto;
    }

    #shopify-section-{{ section.id }} .beauty-hero__main-image {
      max-width: 540px;
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    #shopify-section-{{ section.id }} .beauty-hero__slide {
      min-height: auto;
    }

    #shopify-section-{{ section.id }} .beauty-hero__inner {
      min-height: auto;
      padding: 30px 16px 22px;
    }

    #shopify-section-{{ section.id }} .beauty-hero__title {
      font-size: 42px;
    }

    #shopify-section-{{ section.id }} .beauty-hero__brand {
      font-size: 16px;
    }

    #shopify-section-{{ section.id }} .beauty-hero__offer {
      font-size: 18px;
    }

    #shopify-section-{{ section.id }} .beauty-hero__desc {
      font-size: 14px;
      line-height: 1.5;
    }

    #shopify-section-{{ section.id }} .beauty-hero__btn {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .beauty-hero__main-image {
      max-width: 100%;
      max-height: none;
    }
  }
{% endstyle %}

{% if hero_slide_count > 1 %}
  <script>
    (() => {
      const hero = document.getElementById({{ hero_slider_id | json }});
      if (!hero) return;

      const track = hero.querySelector(".beauty-hero__track");
      const slides = Array.from(hero.querySelectorAll(".beauty-hero__slide"));
      const indicators = hero.querySelector(".beauty-hero__indicators");
      const autoplayDelay = Number(hero.dataset.autoplayMs) || 3000;
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let currentIndex = 0;
      let autoplayId = null;

      if (!track || slides.length < 2 || !indicators) return;

      function setActiveSlide(index) {
        currentIndex = (index + slides.length) % slides.length;
        track.style.transform = `translateX(-${currentIndex * 100}%)`;

        indicators.querySelectorAll(".beauty-hero__indicator").forEach((indicator, indicatorIndex) => {
          const isActive = indicatorIndex === currentIndex;
          indicator.classList.toggle("is-active", isActive);
          indicator.setAttribute("aria-current", isActive ? "true" : "false");
        });
      }

      function stopAutoplay() {
        if (autoplayId) {
          window.clearInterval(autoplayId);
          autoplayId = null;
        }
      }

      function startAutoplay() {
        stopAutoplay();

        if (reducedMotion.matches) {
          return;
        }

        autoplayId = window.setInterval(() => {
          setActiveSlide(currentIndex + 1);
        }, autoplayDelay);
      }

      indicators.innerHTML = "";

      slides.forEach((_, slideIndex) => {
        const indicator = document.createElement("button");
        indicator.type = "button";
        indicator.className = "beauty-hero__indicator";
        indicator.setAttribute("aria-label", `Show banner slide ${slideIndex + 1}`);
        indicator.addEventListener("click", () => {
          setActiveSlide(slideIndex);
          startAutoplay();
        });
        indicators.appendChild(indicator);
      });

      hero.addEventListener("mouseenter", stopAutoplay);
      hero.addEventListener("mouseleave", startAutoplay);
      hero.addEventListener("focusin", stopAutoplay);
      hero.addEventListener("focusout", (event) => {
        if (!hero.contains(event.relatedTarget)) {
          startAutoplay();
        }
      });

      if (typeof reducedMotion.addEventListener === "function") {
        reducedMotion.addEventListener("change", startAutoplay);
      } else if (typeof reducedMotion.addListener === "function") {
        reducedMotion.addListener(startAutoplay);
      }

      setActiveSlide(0);
      startAutoplay();
    })();
  </script>
{% endif %}

