<section class="why-shop">
  <div class="why-shop__container">
    <div class="why-shop__header">
      {% if section.settings.label != blank %}
        <span class="why-shop__label">{{ section.settings.label }}</span>
      {% endif %}

      {% if section.settings.title != blank %}
        <h2 class="why-shop__title">{{ section.settings.title }}</h2>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <p class="why-shop__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="why-shop__grid">
      {% for block in section.blocks %}
        <div class="why-card" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <div class="why-icon">{{ block.settings.icon }}</div>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h3>{{ block.settings.heading }}</h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <p>{{ block.settings.text }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .why-shop {
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    background: linear-gradient(180deg, {{ section.settings.background_start }}, {{ section.settings.background_end }});
  }

  #shopify-section-{{ section.id }} .why-shop__container {
    max-width: 1200px;
    margin: auto;
  }

  #shopify-section-{{ section.id }} .why-shop__header {
    text-align: center;
    margin-bottom: 50px;
  }

  #shopify-section-{{ section.id }} .why-shop__label {
    display: inline-block;
    padding: 8px 16px;
    border-radius: 30px;
    background: #ffffff;
    border: 1px solid {{ section.settings.label_border_color }};
    color: {{ section.settings.accent_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  #shopify-section-{{ section.id }} .why-shop__title {
    font-size: 36px;
    font-family: Georgia, serif;
    color: {{ section.settings.heading_color }};
    margin-bottom: 10px;
  }

  #shopify-section-{{ section.id }} .why-shop__subtitle {
    color: {{ section.settings.text_color }};
    font-size: 16px;
    max-width: 600px;
    margin: auto;
  }

  #shopify-section-{{ section.id }} .why-shop__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 26px;
  }

  #shopify-section-{{ section.id }} .why-card {
    background: {{ section.settings.card_background }};
    padding: 30px 24px;
    border-radius: 22px;
    text-align: center;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
    transition: 0.3s;
  }

  #shopify-section-{{ section.id }} .why-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);
  }

  #shopify-section-{{ section.id }} .why-icon {
    font-size: 32px;
    margin-bottom: 14px;
  }

  #shopify-section-{{ section.id }} .why-card h3 {
    font-size: 18px;
    margin-bottom: 10px;
    font-weight: 600;
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .why-card p {
    font-size: 14px;
    color: {{ section.settings.text_color }};
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .why-shop__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} .why-shop__grid {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .why-shop__title {
      font-size: 30px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Why Shop With Us",
  "tag": "section",
  "class": "section-why-shop-with-us",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Why Choose Us"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Why Shop With Us?"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "We make beauty simple, reliable, and enjoyable — from product quality to delivery."
    },
    {
      "type": "color",
      "id": "background_start",
      "label": "Background start",
      "default": "#fff8fb"
    },
    {
      "type": "color",
      "id": "background_end",
      "label": "Background end",
      "default": "#fff1f6"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#c53a7a"
    },
    {
      "type": "color",
      "id": "label_border_color",
      "label": "Label border color",
      "default": "#ffd6e6"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1d0f15"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#6b5b61"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 90,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 90,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "🚚"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Fast & Reliable Shipping"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Your glow essentials are processed quickly and shipped with care so you receive them without delays."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Shop With Us",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card",
          "settings": {
            "icon": "🌿",
            "heading": "Skin-Safe Ingredients",
            "text": "Our formulas are thoughtfully created to be gentle, safe, and supportive of healthy, radiant skin."
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "🔒",
            "heading": "100% Secure Checkout",
            "text": "Shop confidently with encrypted and secure payment systems designed to protect every transaction."
          }
        },
        {
          "type": "card",
          "settings": {
            "icon": "↩️",
            "heading": "Hassle-Free Returns",
            "text": "If something isn’t right, our easy return process ensures your experience stays smooth and worry-free."
          }
        }
      ]
    }
  ]
}
{% endschema %}
