<section class="beauty-values">
  <div class="beauty-values__wrap">
    <div class="beauty-values__intro">
      {% if section.settings.label != blank %}
        <span class="beauty-values__label">{{ section.settings.label }}</span>
      {% endif %}

      {% if section.settings.title != blank %}
        <h2 class="beauty-values__title">{{ section.settings.title }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <p class="beauty-values__text">{{ section.settings.text }}</p>
      {% endif %}
    </div>

    <div class="beauty-values__grid">
      {% for block in section.blocks %}
        <div
          class="beauty-values__card{% if block.settings.highlight %} beauty-values__card--highlight{% endif %}"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.icon != blank %}
            <div class="beauty-values__icon">{{ block.settings.icon }}</div>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h3>{{ block.settings.heading }}</h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <p>{{ block.settings.text }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .beauty-values {
    position: relative;
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    background:
      radial-gradient(circle at top left, {{ section.settings.accent_color | color_modify: 'alpha', 0.45 }}, transparent 30%),
      radial-gradient(circle at bottom right, {{ section.settings.background_end | color_modify: 'alpha', 0.9 }}, transparent 28%),
      linear-gradient(180deg, {{ section.settings.background_start }} 0%, {{ section.settings.background_end }} 100%);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .beauty-values::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(255, 255, 255, 0.18) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.18) 1px, transparent 1px);
    background-size: 36px 36px;
    opacity: 0.35;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .beauty-values__wrap {
    position: relative;
    z-index: 1;
    max-width: 1240px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .beauty-values__intro {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 42px;
  }

  #shopify-section-{{ section.id }} .beauty-values__label {
    display: inline-block;
    margin-bottom: 14px;
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid {{ section.settings.accent_color | color_modify: 'alpha', 0.12 }};
    color: {{ section.settings.accent_color }};
    font-family: Arial, Helvetica, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .beauty-values__title {
    margin: 0 0 12px;
    color: {{ section.settings.heading_color }};
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    font-weight: 600;
    font-family: Georgia, "Times New Roman", serif;
  }

  #shopify-section-{{ section.id }} .beauty-values__text {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: 16px;
    line-height: 1.7;
    font-family: Arial, Helvetica, sans-serif;
  }

  #shopify-section-{{ section.id }} .beauty-values__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }

  #shopify-section-{{ section.id }} .beauty-values__card {
    position: relative;
    padding: 28px 22px;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid {{ section.settings.accent_color | color_modify: 'alpha', 0.08 }};
    box-shadow: 0 12px 35px {{ section.settings.accent_color | color_modify: 'alpha', 0.06 }};
    backdrop-filter: blur(10px);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  #shopify-section-{{ section.id }} .beauty-values__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px {{ section.settings.accent_color | color_modify: 'alpha', 0.1 }};
  }

  #shopify-section-{{ section.id }} .beauty-values__card--highlight {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.82), rgba(255, 242, 247, 0.95));
    border-color: {{ section.settings.accent_color | color_modify: 'alpha', 0.14 }};
  }

  #shopify-section-{{ section.id }} .beauty-values__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    margin-bottom: 18px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ffd8e7 0%, #f7b7d1 100%);
    color: {{ section.settings.accent_color }};
    font-size: 18px;
    box-shadow: 0 8px 18px {{ section.settings.accent_color | color_modify: 'alpha', 0.12 }};
  }

  #shopify-section-{{ section.id }} .beauty-values__card h3 {
    margin: 0 0 10px;
    color: {{ section.settings.heading_color }};
    font-size: 20px;
    line-height: 1.25;
    font-weight: 600;
    font-family: Georgia, "Times New Roman", serif;
  }

  #shopify-section-{{ section.id }} .beauty-values__card p {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: 14px;
    line-height: 1.7;
    font-family: Arial, Helvetica, sans-serif;
  }

  @media (max-width: 991px) {
    #shopify-section-{{ section.id }} .beauty-values {
      padding-left: 18px;
      padding-right: 18px;
    }

    #shopify-section-{{ section.id }} .beauty-values__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    #shopify-section-{{ section.id }} .beauty-values {
      padding-left: 16px;
      padding-right: 16px;
    }

    #shopify-section-{{ section.id }} .beauty-values__intro {
      margin-bottom: 30px;
    }

    #shopify-section-{{ section.id }} .beauty-values__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    #shopify-section-{{ section.id }} .beauty-values__card {
      padding: 24px 18px;
      border-radius: 20px;
    }

    #shopify-section-{{ section.id }} .beauty-values__card h3 {
      font-size: 18px;
    }

    #shopify-section-{{ section.id }} .beauty-values__text {
      font-size: 15px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Beauty Values",
  "tag": "section",
  "class": "section-beauty-values",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Why You'll Love Us"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Beauty you can trust, curated with intention."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Founder-led, consciously curated essentials created for effortless glow, everyday confidence, and a shopping experience that feels smooth from checkout to delivery."
    },
    {
      "type": "color",
      "id": "background_start",
      "label": "Background start",
      "default": "#fff8fa"
    },
    {
      "type": "color",
      "id": "background_end",
      "label": "Background end",
      "default": "#fff2f6"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#a70055"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1b1115"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#6b5960"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 140,
      "step": 4,
      "default": 80,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "✦"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Founder-led brand"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Every product is thoughtfully selected with care, quality, and real everyday wear in mind."
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlight card",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Beauty Values",
      "blocks": [
        {
          "type": "value"
        },
        {
          "type": "value",
          "settings": {
            "heading": "Fast, reliable shipping",
            "text": "Your glow essentials are packed and delivered with speed, care, and dependable service."
          }
        },
        {
          "type": "value",
          "settings": {
            "heading": "Secure checkout",
            "text": "Shop confidently with a smooth, protected checkout experience built for peace of mind."
          }
        },
        {
          "type": "value",
          "settings": {
            "heading": "Vegan & Cruelty Free",
            "text": "Clean beauty choices that align with conscious values without compromising on performance.",
            "highlight": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
