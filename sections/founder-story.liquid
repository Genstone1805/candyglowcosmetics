{% liquid
  assign image_url = section.settings.image_url
  if section.settings.image != blank
    assign image_url = section.settings.image | image_url: width: 1400
  endif
%}

<section class="founder-section">
  <div class="founder-container">
    <div class="founder-image">
      {% if image_url != blank %}
        <img
          src="{{ image_url }}"
          alt="{{ section.settings.image_alt | default: section.settings.title | escape }}"
          loading="lazy"
        >
      {% endif %}
    </div>

    <div class="founder-content">
      {% if section.settings.label != blank %}
        <span class="founder-label">{{ section.settings.label }}</span>
      {% endif %}

      {% if section.settings.title != blank %}
        <h2 class="founder-title">{{ section.settings.title }}</h2>
      {% endif %}

      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'paragraph' %}
            {% if block.settings.text != blank %}
              <p class="founder-text" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
            {% endif %}
        {% endcase %}
      {% endfor %}

      <div class="founder-buttons">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'button' %}
              {% if block.settings.label != blank %}
                <a
                  href="{{ block.settings.link | default: '#' }}"
                  class="{% if block.settings.style == 'secondary' %}btn-outline{% else %}btn-primary{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.label }}
                </a>
              {% endif %}
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% style %}
  #shopify-section-{{ section.id }} .founder-section {
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    background: linear-gradient(180deg, {{ section.settings.background_start }}, {{ section.settings.background_end }});
  }

  #shopify-section-{{ section.id }} .founder-container {
    max-width: 1200px;
    margin: auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .founder-image {
    position: relative;
  }

  #shopify-section-{{ section.id }} .founder-image img {
    width: 100%;
    border-radius: 28px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.15);
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .founder-label {
    display: inline-block;
    background: #ffffff;
    border: 1px solid {{ section.settings.label_border_color }};
    color: {{ section.settings.accent_color }};
    padding: 8px 16px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  #shopify-section-{{ section.id }} .founder-title {
    font-size: 40px;
    font-family: Georgia, serif;
    margin-bottom: 20px;
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .founder-text {
    font-size: 16px;
    line-height: 1.8;
    color: {{ section.settings.text_color }};
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .founder-buttons {
    margin-top: 26px;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .btn-primary,
  #shopify-section-{{ section.id }} .btn-outline {
    padding: 14px 26px;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    transition: 0.3s;
  }

  #shopify-section-{{ section.id }} .btn-primary {
    background: {{ section.settings.primary_button_background }};
    color: {{ section.settings.primary_button_text }};
  }

  #shopify-section-{{ section.id }} .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
  }

  #shopify-section-{{ section.id }} .btn-outline {
    border: 1px solid {{ section.settings.secondary_button_border }};
    color: {{ section.settings.secondary_button_text }};
    background: {{ section.settings.secondary_button_background }};
  }

  #shopify-section-{{ section.id }} .btn-outline:hover {
    background: {{ section.settings.secondary_button_hover_background }};
    color: {{ section.settings.secondary_button_hover_text }};
  }

  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .founder-container {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    #shopify-section-{{ section.id }} .founder-title {
      font-size: 32px;
    }
  }
{% endstyle %}

{% schema %}
