    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Candy Glow Founder"
    },
    {
      "type": "color",
      "id": "background_start",
      "label": "Background start",
      "default": "#fff6f9"
    },
    {
      "type": "color",
      "id": "background_end",
      "label": "Background end",
      "default": "#fff1f6"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#c53a7a"
    },
    {
